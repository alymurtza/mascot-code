{
  "name": "mascot-downloader",
  "productName": "Mascot",
  "version": "0.5.2",
  "description": "Download files and torrents faster by using all your internet connections at once.",
  "main": "./out/main/index.js",
  "author": "Mascot Downloader",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --import tsx --test \"test/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "build:extension": "node extension/build.mjs",
    "build:win": "bash tools/windows-build/build.sh",
    "setup:test-libs": "bash tools/test-libs.sh"
  },
  "dependencies": {
    "electron-updater": "6.6.2",
    "koffi": "^2.16.3",
    "webtorrent": "3.0.21"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@eslint/js": "^9.39.1",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^44.4.4",
    "electron-builder": "^26.16.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "lucide-react": "^1.47.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.6",
    "zustand": "^5.0.15"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alymurtza/mascot-downloader.git"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "koffi": true,
    "node-datachannel": true,
    "electron-winstaller": true,
    "bufferutil": false,
    "utf-8-validate": false,
    "utp-native": false,
    "ip-set": false
  }
}
